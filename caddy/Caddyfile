# Caddy terminates TLS for every link domain and forwards to the redirect.
#
# A certificate is obtained on the first HTTPS request for a host name, and
# only after the redirect has said yes to the `ask` check below: yes means a
# domain an admin added and verified. Any other host name pointed at this
# server gets no certificate, so nobody outside can make this install ask a
# certificate authority for one.
{
	# HTTP/1.1 and HTTP/2 only. HTTP/3 runs over UDP, and docker-compose.yml
	# publishes 443 as TCP alone, so advertising HTTP/3 would point clients
	# at a port the host never forwards: they try it, get nothing, and fall
	# back. To turn it on, publish `443:443/udp` for caddy as well and add
	# h3 to the line below. The two only make sense together.
	servers {
		protocols h1 h2
	}

	on_demand_tls {
		# The internal port, reachable on the stack's own network and
		# published nowhere.
		ask http://redirect:9091/ask
	}
}

# Every host name. The admin API answers on the one host name the install is
# configured with; every other name goes to the redirect, which answers for
# the ones it knows and serves a 404 page for the rest.
#
# The site addresses are ports, not names, on purpose. A named site block would
# make Caddy try to obtain a certificate for that name at boot, which fails
# loudly on an install that has not set CLICKMONK_ADMIN_HOST yet.
#
# The admin matcher is a CEL expression rather than `host {$CLICKMONK_ADMIN_HOST}`,
# and the word `expression` is the whole of what makes an unset install safe.
# Compose sets that variable either way, and a `host` matcher whose value is the
# empty string is refused — "module value cannot be null" — at boot as well as
# under `caddy validate`. Under `restart: unless-stopped` that is a crash-loop,
# and Caddy is the only service with a published port, so it would be the whole
# install. An expression is evaluated per request instead, and `host("")`
# simply matches nothing, so with nothing set every name goes to the redirect.
#
# The `!= ""` clause is not what saves it — drop it and an empty variable still
# starts and still routes everything to the redirect. It is here to say the
# empty case is intended, and to skip the host match when there is nothing to
# match. The match itself is Caddy's own: case-insensitive, and a port in Host
# does not defeat it.
#
# Plain HTTP is proxied rather than redirected for a link: a domain that has
# not been verified has no certificate, and a local trial has no domain at all.
# The admin host is redirected to HTTPS instead, because its session cookie is
# `Secure` and a browser drops that over plain HTTP — signing in would appear
# to work and then not.
:443 {
	tls {
		on_demand
		import /etc/caddy/tls.d/*.caddy
	}
	@admin expression {env.CLICKMONK_ADMIN_HOST} != "" && host({env.CLICKMONK_ADMIN_HOST})
	handle @admin {
		reverse_proxy admin:9100 {
			import /etc/caddy/proxy.d/*.caddy
		}
	}
	handle {
		reverse_proxy redirect:8080 {
			import /etc/caddy/proxy.d/*.caddy
		}
	}
}

:80 {
	@admin expression {env.CLICKMONK_ADMIN_HOST} != "" && host({env.CLICKMONK_ADMIN_HOST})
	handle @admin {
		# 308, not Caddy's `permanent` (301): a 301 lets a client turn a POST
		# into a GET, so a sign-in sent to the plain-HTTP port would arrive as
		# an empty GET rather than being retried as itself over HTTPS.
		redir https://{host}{uri} 308
	}
	handle {
		reverse_proxy redirect:8080 {
			import /etc/caddy/proxy.d/*.caddy
		}
	}
}
