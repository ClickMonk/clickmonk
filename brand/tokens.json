{
  "$meta": {
    "name": "ClickMonk design tokens",
    "note": "Light is canonical; dark is derived. Every pairing is measured, not asserted: see contrast-report.txt. Danger is status only, never an accent."
  },
  "palette": {
    "accent": {
      "50": "#EAF6F4",
      "100": "#D1EBE7",
      "200": "#A1D7CF",
      "300": "#6EBFB5",
      "400": "#37A99D",
      "500": "#009589",
      "600": "#007F75",
      "700": "#006A61",
      "800": "#00524B",
      "900": "#003631"
    },
    "neutral": {
