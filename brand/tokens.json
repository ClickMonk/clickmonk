      "25": "#F8FBFB",
      "50": "#F1F5F5",
      "100": "#E7EDED",
      "200": "#DAE1E1",
      "300": "#BFC9C9",
      "400": "#9CA6A7",
      "500": "#737D7D",
      "600": "#555D5D",
      "700": "#3E4444",
      "800": "#262A2B",
      "900": "#181B1B",
      "950": "#101111"
