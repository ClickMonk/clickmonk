    "text": "#101111",
    "text-muted": "#555D5D",
    "text-subtle": "#737D7D",
    "text-inverse": "#F8FBFB",
    "accent": "#006A61",
    "accent-hover": "#00524B",
    "accent-surface": "#EAF6F4",
