# Copy to .env and fill in every value; compose refuses to start while any
# is empty. Generate each with:
#   openssl rand -hex 32
# Password for the clickmonk Postgres user.
POSTGRES_PASSWORD=
# Password for the clickmonk ClickHouse user.
CLICKHOUSE_PASSWORD=
# Signs visitor cookies. At least 32 characters.
CLICKMONK_SECRET=
# IP data downloads (country, ASN, hosting networks and Tor exits), on by
# default. Set to off on a host without internet access: countries then stay
# unknown and the IP checks do not run.
CLICKMONK_IPDATA_UPDATE=on
