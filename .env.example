# Copy to .env and fill in every value; compose refuses to start while any
# is empty. `./install.sh` writes this file for you with fresh values.
# Generate each with:
#   openssl rand -hex 32
# Password for the clickmonk Postgres user.
POSTGRES_PASSWORD=
# Password for the clickmonk ClickHouse user.
CLICKHOUSE_PASSWORD=
# Signs visitor cookies. At least 32 characters.
CLICKMONK_SECRET=
# IP data downloads (country, ASN, hosting networks and Tor exits), on by
# default. Set to off on a host without internet access: countries then stay
# unknown and the IP checks do not run.
CLICKMONK_IPDATA_UPDATE=on
# Checking that each link domain still publishes its verification TXT record,
# on by default, every five minutes. Off leaves every domain as it was added.
CLICKMONK_DNS_CHECK=on
# Which resolvers to ask, comma separated, each an address and optionally a
# port ([2001:db8::1]:5353 for IPv6). Empty means the host's own.
CLICKMONK_DNS_SERVERS=
# Where X-Forwarded-For is believed from: comma-separated addresses, ranges
# such as 172.17.0.0/16, or loopback, linklocal and uniquelocal. The default
# names the private and loopback ranges, which is where Caddy is: it is the
# only service in the stack with a published port, and nothing outside can
# reach the redirect to claim an address. Narrow it if you publish the
# redirect yourself, and set your own CDN's ranges in caddy/proxy.d instead
# if one sits in front of Caddy.
# A /0 range is refused.
CLICKMONK_TRUSTED_PROXIES=uniquelocal,loopback
# The IPv6 range the stack's own Docker network uses. Change it only if it
# collides with a network this host already has.
CLICKMONK_IPV6_SUBNET=fd00:c11c:0::/64
